{
  "name": "sudo-by-contract",
  "private": true,
  "description": "Programmable, auditable, ephemeral machine authority for AI agents, on NEAR.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/sudoctl",
    "apps/relay",
    "apps/demo-agent",
    "apps/sbc-mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/sudoctl/test/*.test.ts\" \"apps/relay/test/*.test.ts\" \"apps/sbc-mcp/test/*.test.ts\" \"apps/demo-agent/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:live": "node scripts/verify-live.ts",
    "judge": "node scripts/judge.ts",
    "build:wasm": "node scripts/build-wasm.ts"
  },
  "devDependencies": {
    "@near-js/crypto": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "@types/node": "^24.19.2",
    "typescript": "5.9"
  }
}
