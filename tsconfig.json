{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/sudoctl/src/**/*.ts",
    "apps/sudoctl/test/**/*.ts",
    "apps/relay/src/**/*.ts",
    "apps/relay/test/**/*.ts",
    "apps/demo-agent/src/**/*.ts",
    "apps/sbc-mcp/src/**/*.ts",
    "apps/sbc-mcp/test/**/*.ts"
  ]
}
